# Copy this file to scripts/.env and fill in the values.

# Stellar network RPC endpoint.
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.mainnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (must match the network above).
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployer account secret key (S...). Fund it with the Friendbot on testnet,
# or with XLM on mainnet, before deploying.
SOURCE_ACCOUNT=S...

# Address that should own the deployed contracts (G... or C...).
ADMIN=G...

# Optional: ed25519 public key (32 bytes, hex) of the prover service, used to
# auto-initialize the zk-verifier contract. Required if zk-verifier is in the
# deployment set.
# VERIFIER_PK=...

# Optional: CLI binary. Defaults to `soroban`; use `stellar` for the newer CLI.
# CLI=soroban
#
# Optional: the flag used to pass the signing account. The older soroban CLI
# uses `source-account`; newer stellar CLI versions use `source`. Set this if
# your CLI rejects the default.
# SOURCE_FLAG=source-account

# --- Smoke test (scripts/smoke-test.sh) ---
# Runs an end-to-end conversion flow on the batch-conversion contract.
# For the smoke test, ADMIN must be the PUBLIC KEY (G...) of the
# SOURCE_ACCOUNT secret key, so admin-required operations (token minting,
# conversion, liquidity withdrawal) can be authorized with SOURCE_ACCOUNT.
# Optional overrides:
# SMOKE_FROM_CODE=SMOKE1
# SMOKE_TO_CODE=SMOKE2
# SMOKE_AMOUNT_IN=100
# SMOKE_MIN_AMOUNT_OUT=90
# SMOKE_LIQUIDITY=1000
# SMOKE_RATE_NUMERATOR=9
# SMOKE_RATE_DENOMINATOR=10

# Optional: per-contract init-arg overrides (package dashes -> underscores).
# INIT_ARGS_spending_rules="-- --admin G... --category_contract C... --zk_verifier_contract C..."
